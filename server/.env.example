NODE_ENV=development
PORT=4000
# Local MongoDB, or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/nmamit_portal
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# Institutional email domains accepted at sign-up (comma-separated). Confirm the real list with your administrator.
ALLOWED_EMAIL_DOMAINS=nmamit.in,nitte.edu.in
# Secret HODs must enter to register (give it only to HODs). Empty = HOD registration disabled. Use 8+ characters.
HOD_ACCESS_CODE=dev-hod-code
# Reverse proxies in front of the API: 0 locally, 1 on Render
TRUST_PROXY_HOPS=0
# Evidence files: disk (dev default) or mongo (production default; survives restarts on hosts with temporary disks)
STORAGE_DRIVER=disk
UPLOAD_DIR=./uploads
